def isZero =
  \n:Nat. R (suc 0) (\k:Nat. \z:Nat. 0) n

def eq =
  \m:Nat.
    R isZero
      (\f:(Nat -> Nat). \mm:Nat. \n:Nat.
         R 0 (\a:Nat. \z:Nat. f z) n)
      m

def member =
  \x:Nat. \xs:List Nat.
    RL 0
      (\y:Nat. \acc:Nat.
         R acc (\k:Nat. \z:Nat. suc 0) (eq x y))
      xs

def append = \xs:List Nat. \n:Nat.
  RL (cons n nil) (\x:Nat. \rec:List Nat. cons x rec) xs

def rev = \xs:List Nat.
  RL nil (\x:Nat. \rec:List Nat. append rec x) xs

def elimDups = \xs:List Nat.
  rev (RL nil
        (\n:Nat. \rec:List Nat.
           R (cons n rec)
             (\r:List Nat. \k:Nat. rec)
             (member n rec))
        (rev xs))
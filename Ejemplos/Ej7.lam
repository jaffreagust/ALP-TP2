def isZero =
  \n:Nat. R (suc 0) (\k:Nat. \z:Nat. 0) n

def eq =
  \m:Nat.
    R isZero
      (\f:(Nat -> Nat). \mm:Nat. \n:Nat.
         R 0 (\a:Nat. \z:Nat. f z) n)
      m

def member =
  \x:Nat. \xs:List Nat.
    RL 0
      (\y:Nat. \acc:Nat.
         R acc (\k:Nat. \z:Nat. suc 0) (eq x y))
      xs

def rev = \xs:List Nat.
  (RL (\acc:List Nat. acc)
      (\x:Nat. \g:List Nat -> List Nat. \acc:List Nat. g (cons x acc))
      xs)
  nil

def elimDups = \xs:List Nat.
  rev ((RL (\acc:List Nat. acc)
          (\n:Nat. \g:List Nat -> List Nat. \acc:List Nat.
             g (R (cons n acc)
                  (\r:List Nat. \k:Nat. acc)
                  (member n acc)))
          xs)
       nil)